# Ollama runs only on your computer. Install Ollama and pull a model to enable it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Optional hosted provider. Keep this key in .env.local/server environment only.
# Groq Cloud sends prompts to Groq; free-tier limits and paid usage terms apply.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
